files:
  "/opt/aws/amazon-cloudwatch-agent/etc/akive_tracing_config.json":
    mode: "0644"
    owner: root
    group: root
    content: |
      {
        "traces": {
          "traces_collected": {
            "otlp": {
              "http_endpoint": "0.0.0.0:4318"
            }
          }
        }
      }

container_commands:
  03_append_cloudwatch_tracing_config:
    command: >
      /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl
      -a append-config
      -m ec2
      -s
      -c file:/opt/aws/amazon-cloudwatch-agent/etc/akive_tracing_config.json
  04_remove_cloudwatch_tracing_config_backup:
    command: rm -f /opt/aws/amazon-cloudwatch-agent/etc/akive_tracing_config.json.bak
    ignoreErrors: true
