files:
  "/opt/aws/amazon-cloudwatch-agent/etc/akive_security_log_config.json":
    mode: "0644"
    owner: root
    group: root
    content:
      logs:
        logs_collected:
          files:
            collect_list:
              - file_path: /var/log/akive/security/security.log
                log_group_name:
                  Fn::Join:
                    - "/"
                    - - /aws/elasticbeanstalk
                      - Ref: AWSEBEnvironmentName
                      - security
                log_stream_name: "{instance_id}"
                retention_in_days: 90

container_commands:
  01_append_cloudwatch_security_log_config:
    command: >
      /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl
      -a append-config
      -m ec2
      -s
      -c file:/opt/aws/amazon-cloudwatch-agent/etc/akive_security_log_config.json
  02_remove_cloudwatch_security_log_config_backup:
    command: rm -f /opt/aws/amazon-cloudwatch-agent/etc/akive_security_log_config.json.bak
    ignoreErrors: true
